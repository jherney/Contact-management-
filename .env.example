# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION SECRET
# Used for signing session cookies. Generate a random string for production.
# When running with Docker Compose, the app sets this internally.
SESSION_SECRET="your-secret-key-here"

# VERCEL POSTGRES DATABASE CONFIGURATION (Option A)
# Auto-populated when connecting a Vercel Postgres / Neon database in Vercel Dashboard
# For Docker Compose: the app container auto-connects to the bundled postgres:16 service
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# VERCEL KV (REDIS) DATABASE CONFIGURATION (Option B)
# Auto-populated when connecting a Vercel KV store in Vercel Dashboard
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
